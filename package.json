{
  "name": "react-a11y-monorepo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b packages/core packages/rules-web packages/rules-native packages/cli",
    "test": "vitest run",
    "clean": "rm -rf packages/*/dist packages/*/tsconfig.tsbuildinfo"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
