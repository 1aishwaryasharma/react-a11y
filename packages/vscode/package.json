{
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:typescript",
    "onLanguage:typescriptreact"
  ],
  "bugs": {
    "url": "https://github.com/1aishwaryasharma/react-a11y/issues"
  },
  "categories": [
    "Linters"
  ],
  "contributes": {
    "commands": [
      {
        "command": "react-a11y.fixAll",
        "title": "react-a11y: Fix all auto-fixable issues in this file"
      },
      {
        "command": "react-a11y.scanWorkspace",
        "title": "react-a11y: Scan workspace (project-wide checks)"
      }
    ],
    "configuration": {
      "properties": {
        "react-a11y.enable": {
          "default": true,
          "description": "Enable react-a11y diagnostics.",
          "type": "boolean"
        },
        "react-a11y.platform": {
          "default": "auto",
          "description": "Rule pack to run. \"auto\" detects React Native/Expo from the workspace package.json.",
          "enum": [
            "auto",
            "web",
            "native"
          ],
          "type": "string"
        }
      },
      "title": "react-a11y"
    }
  },
  "dependencies": {
    "@aishware/react-a11y-core": "0.5.0",
    "@aishware/react-a11y-rules-native": "0.5.0",
    "@aishware/react-a11y-rules-web": "0.5.0"
  },
  "description": "Inline WCAG 2.2 accessibility diagnostics and quick fixes for React and React Native.",
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1"
  },
  "displayName": "react-a11y",
  "engines": {
    "vscode": "^1.85.0"
  },
  "galleryBanner": {
    "color": "#D9F5FF",
    "theme": "light"
  },
  "homepage": "https://github.com/1aishwaryasharma/react-a11y",
  "icon": "images/icon.png",
  "keywords": [
    "accessibility",
    "a11y",
    "wcag",
    "react",
    "react-native"
  ],
  "license": "MIT",
  "main": "./dist/extension.js",
  "name": "react-a11y",
  "pricing": "Free",
  "private": true,
  "publisher": "aishwaryasharma",
  "qna": "marketplace",
  "repository": {
    "directory": "packages/vscode",
    "type": "git",
    "url": "git+https://github.com/1aishwaryasharma/react-a11y.git"
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --minify --platform=node --format=cjs --external:vscode --outfile=dist/extension.js --define:import.meta.url=__importMetaUrl \"--banner:js=const __importMetaUrl = require('node:url').pathToFileURL(__filename).href;\"",
    "package": "vsce package --no-dependencies",
    "typecheck": "tsc --noEmit",
    "vscode:prepublish": "npm run typecheck && npm run build"
  },
  "version": "0.5.0"
}
